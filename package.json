{
  "name": "dashboard-platform",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Dashboard Platform Application",
  "author": "Jack Wu <mailto:48574669+ohayowu314@users.noreply.github.com>",
  "main": "dist-electron/electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "type-check": "tsc -b --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project electron/tsconfig.json",
    "prebuild:electron": "npm run transpile:electron && npm run build",
    "dist:mac": "run-s prebuild:electron \"electron-builder --mac --arm64\"",
    "dist:win": "run-s prebuild:electron \"electron-builder --win --x64\"",
    "dist:linux": "run-s prebuild:electron \"electron-builder --linux --x64\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "better-sqlite3": "^12.9.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  }
}